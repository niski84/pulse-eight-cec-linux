[Unit]
Description=Pulse-Eight HDMI-CEC input bridge
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/pulse-eight-cec daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
Environment=P8CEC_SOCKET=%t/pulse-eight-cec.sock
UMask=0077

[Install]
WantedBy=default.target
